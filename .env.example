SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
PORT=3000

# ---------------------------------------------------------------
# Sales Copilot (/copilot) — see docs/sales-copilot-guide.md
# ---------------------------------------------------------------
# Login (single user for the pilot)
COPILOT_USER_EMAIL=tammy@example.com
COPILOT_USER_PASSWORD=change-me-to-a-long-password
# Signs the login cookie. Any long random string; changing it logs everyone out.
COPILOT_SESSION_SECRET=

# OpenAI (server-side only, never sent to the browser)
OPENAI_API_KEY=sk-...
# Models (defaults shown) — change without touching code
COPILOT_LLM_MODEL=gpt-4.1-mini
COPILOT_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
COPILOT_TTS_MODEL=gpt-4o-mini-tts
# Optional
# COPILOT_TTS_VOICE=coral
# COPILOT_WEB_SEARCH_TOOL=web_search
# COPILOT_TIMEZONE=Asia/Bangkok
# OPENAI_BASE_URL=https://api.openai.com/v1

# Supabase service role key (Settings → API). Needed so the copilot can use its
# private tables (RLS on, no public policies). Without it, copilot data is
# saved to data/copilot-store.json on the server instead.
SUPABASE_SERVICE_ROLE_KEY=
